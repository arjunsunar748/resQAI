# ==============================================================================
# RESQ AGENT - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.

# Application Profile: development | staging | production
APP_ENV=development
APP_NAME="ResQ AI Command Center"
DEBUG=true
API_V1_STR=/api/v1

# Security & Cryptography
# Generate a secure 256-bit key using: openssl rand -hex 32
SECRET_KEY=change-this-to-a-super-secret-hex-token-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test123
POSTGRES_DB=resq_ai_db
DATABASE_URL=postgresql://postgres:test123@localhost:5432/resq_ai_db

# Redis (Caching, Rate Limiting, Pub/Sub)
REDIS_URL=redis://localhost:6379/0

# Cross-Origin Resource Sharing (CORS) - JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# AI Provider Configuration
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
# For cloud providers (optional in development):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Localization & Geographic Boundaries (Default: Nepal)
DEFAULT_COUNTRY_CODE=NPL
DEFAULT_LATITUDE=27.7172
DEFAULT_LONGITUDE=85.3240
DEFAULT_MAP_ZOOM=8
SUPPORTED_LOCALES=["en","ne"]
