# ==============================================================================
# RESQ AGENT - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.
# Never place real secrets, passwords, or production API keys in source code.

# Application Profile
APP_ENV=development
APP_NAME="ResQ AI Command Center"
DEBUG=true
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# Cryptography & Security Secrets
# Generate random 256-bit keys using: openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-secure-random-refresh-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/resq_ai_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=resq_ai_db

# Redis In-Memory Cache, Rate Limiting & Pub/Sub
REDIS_URL=redis://localhost:6379/0

# Cross-Origin Resource Sharing (CORS) - JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# AI Provider Configuration (Phase 4 readiness - local or external LLM)
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3:8b

# Map & GIS Provider Abstraction
MAP_PROVIDER=osm
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"

# Localization & Geographic Boundaries (Nepal Defaults)
DEFAULT_COUNTRY_CODE=NPL
DEFAULT_LATITUDE=27.7172
DEFAULT_LONGITUDE=85.3240
DEFAULT_MAP_ZOOM=8
SUPPORTED_LOCALES=["en","ne"]
